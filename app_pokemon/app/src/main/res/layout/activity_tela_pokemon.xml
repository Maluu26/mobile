<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="UI.tela_pokemon"
    android:padding="20dp">

    <ImageView
        android:id="@+id/back_arrow"
        android:layout_width="45dp"
        android:layout_height="45dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:src="@drawable/outline_arrow_left_alt_24"
/>

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/back_arrow"
        android:textSize="25dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toRightOf="@id/back_arrow"
        android:layout_marginLeft="10dp"
        />
    <ImageView
        android:id="@+id/is_fav"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/heart_svgrepo_com"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="40dp"
        android:layout_marginRight="30dp"
        />
    <ImageView
        android:id="@+id/pokemon"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/circle_svgrepo_com"
        app:layout_constraintTop_toBottomOf="@id/is_fav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />
    <TextView
        android:id="@+id/nome_poke"
        android:text=""
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        />
    <ImageView
        android:id="@+id/female_icon"
        android:layout_width="35dp"
        android:layout_height="35dp"
        app:layout_constraintTop_toBottomOf="@id/pokemon"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/male_icon"
        android:src="@drawable/female_sign_svgrepo_com"
        app:layout_constraintHorizontal_chainStyle="packed"
        android:layout_marginRight="20dp"
        android:layout_marginTop="10dp"
        />

    <ImageView
        android:id="@+id/male_icon"
        android:layout_width="35dp"
        android:layout_height="35dp"
        app:layout_constraintTop_toBottomOf="@id/pokemon"
        app:layout_constraintLeft_toRightOf="@id/female_icon"
        app:layout_constraintRight_toRightOf="parent"
        android:src="@drawable/male_sign_svgrepo_com"
        android:layout_marginTop="10dp"
        />
</androidx.constraintlayout.widget.ConstraintLayout>