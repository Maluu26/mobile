<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="UI.tela_pokemon"
    android:padding="20dp">

    <ImageView
        android:id="@+id/back_arrow"
        android:layout_width="45dp"
        android:layout_height="45dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:src="@drawable/outline_arrow_left_alt_24"
/>

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/back_arrow"
        android:textSize="25dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toRightOf="@id/back_arrow"
        android:layout_marginLeft="10dp"
        />
    <ImageView
        android:id="@+id/is_fav"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/heart_svgrepo_com"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="40dp"
        android:layout_marginRight="30dp"
        />
    <ImageView
        android:id="@+id/pokemon"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/circle_svgrepo_com"
        app:layout_constraintTop_toBottomOf="@id/is_fav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />
    <TextView
        android:id="@+id/nome_poke"
        android:text=""
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="28sp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/pokemon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />
    <LinearLayout
        android:id="@+id/tipos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/nome_poke"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:id="@+id/tipo1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/white"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tipo2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/female_icon"
        android:layout_width="35dp"
        android:layout_height="35dp"
        app:layout_constraintTop_toBottomOf="@id/tipos"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/male_icon"
        android:src="@drawable/female_sign_svgrepo_com"
        app:layout_constraintHorizontal_chainStyle="packed"
        android:layout_marginRight="20dp"
        android:layout_marginTop="10dp"
        />

    <ImageView
        android:id="@+id/male_icon"
        android:layout_width="35dp"
        android:layout_height="35dp"
        app:layout_constraintTop_toBottomOf="@id/tipos"
        app:layout_constraintLeft_toRightOf="@id/female_icon"
        app:layout_constraintRight_toRightOf="parent"
        android:src="@drawable/male_sign_svgrepo_com"
        android:layout_marginTop="10dp"
        />

    <!-- Stats: uma linha colorida por stat. A largura da barra é definida no código -->
    <LinearLayout
        android:id="@+id/stats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@id/female_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:background="@color/stat_hp_fundo">
            <TextView
                android:layout_width="105dp"
                android:layout_height="wrap_content"
                android:text="@string/stat_hp"
                android:textStyle="bold"
                android:textColor="@color/black" />
            <TextView
                android:id="@+id/valor_hp"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:textColor="@color/black" />
            <ProgressBar
                android:id="@+id/barra_hp"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="22dp"
                android:minHeight="22dp"
                android:maxHeight="22dp"
                android:max="255"
                android:progressDrawable="@drawable/barra_stat"
                android:progressTint="@color/stat_hp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:background="@color/stat_ataque_fundo">
            <TextView
                android:layout_width="105dp"
                android:layout_height="wrap_content"
                android:text="@string/stat_ataque"
                android:textStyle="bold"
                android:textColor="@color/black" />
            <TextView
                android:id="@+id/valor_ataque"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:textColor="@color/black" />
            <ProgressBar
                android:id="@+id/barra_ataque"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="22dp"
                android:minHeight="22dp"
                android:maxHeight="22dp"
                android:max="255"
                android:progressDrawable="@drawable/barra_stat"
                android:progressTint="@color/stat_ataque" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:background="@color/stat_defesa_fundo">
            <TextView
                android:layout_width="105dp"
                android:layout_height="wrap_content"
                android:text="@string/stat_defesa"
                android:textStyle="bold"
                android:textColor="@color/black" />
            <TextView
                android:id="@+id/valor_defesa"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:textColor="@color/black" />
            <ProgressBar
                android:id="@+id/barra_defesa"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="22dp"
                android:minHeight="22dp"
                android:maxHeight="22dp"
                android:max="255"
                android:progressDrawable="@drawable/barra_stat"
                android:progressTint="@color/stat_defesa" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:background="@color/stat_atq_es_fundo">
            <TextView
                android:layout_width="105dp"
                android:layout_height="wrap_content"
                android:text="@string/stat_atq_es"
                android:textStyle="bold"
                android:textColor="@color/black" />
            <TextView
                android:id="@+id/valor_atq_es"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:textColor="@color/black" />
            <ProgressBar
                android:id="@+id/barra_atq_es"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="22dp"
                android:minHeight="22dp"
                android:maxHeight="22dp"
                android:max="255"
                android:progressDrawable="@drawable/barra_stat"
                android:progressTint="@color/stat_atq_es" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:background="@color/stat_def_es_fundo">
            <TextView
                android:layout_width="105dp"
                android:layout_height="wrap_content"
                android:text="@string/stat_def_es"
                android:textStyle="bold"
                android:textColor="@color/black" />
            <TextView
                android:id="@+id/valor_def_es"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:textColor="@color/black" />
            <ProgressBar
                android:id="@+id/barra_def_es"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="22dp"
                android:minHeight="22dp"
                android:maxHeight="22dp"
                android:max="255"
                android:progressDrawable="@drawable/barra_stat"
                android:progressTint="@color/stat_def_es" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:background="@color/stat_velocidade_fundo">
            <TextView
                android:layout_width="105dp"
                android:layout_height="wrap_content"
                android:text="@string/stat_velocidade"
                android:textStyle="bold"
                android:textColor="@color/black" />
            <TextView
                android:id="@+id/valor_velocidade"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:textColor="@color/black" />
            <ProgressBar
                android:id="@+id/barra_velocidade"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="22dp"
                android:minHeight="22dp"
                android:maxHeight="22dp"
                android:max="255"
                android:progressDrawable="@drawable/barra_stat"
                android:progressTint="@color/stat_velocidade" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
