<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="UI.MainActivity"
    android:padding="20dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_height="0dp"
        android:layout_width="match_parent"
        app:layout_constraintHeight_percent="0.15"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:background="@color/search_header"
       >

        <ImageView
            android:id="@+id/diamond"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/diamond_svgrepo_com"
            app:layout_constraintTop_toTopOf="@id/header"
            app:layout_constraintBottom_toBottomOf="@id/header"
            app:layout_constraintRight_toLeftOf="@id/circle"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintHorizontal_chainStyle="spread"

        />
        <ImageView
            android:id="@+id/circle"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/circle_svgrepo_com"
            app:layout_constraintTop_toTopOf="@id/header"
            app:layout_constraintBottom_toBottomOf="@id/header"
            app:layout_constraintLeft_toRightOf="@id/diamond"
            app:layout_constraintRight_toLeftOf="@id/square"
            app:layout_constraintHorizontal_chainStyle="spread"
            />

        <ImageView
            android:id="@+id/square"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/square_svgrepo_com"
            app:layout_constraintLeft_toRightOf="@id/circle"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@id/header"
            app:layout_constraintBottom_toBottomOf="@id/header"
            app:layout_constraintHorizontal_chainStyle="spread"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>