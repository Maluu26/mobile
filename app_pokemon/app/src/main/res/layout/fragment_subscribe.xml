<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".SubscribeFragment"
    android:padding="15dp"
    android:layout_marginTop="50dp">

    <ImageView
        android:id="@+id/arrow_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/outline_arrow_left_alt_24"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"

        />

    <TextView
        android:id="@+id/create_account"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColorHint="@color/red"
        android:text="@string/subscribe_screen"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/arrow_back"
        android:layout_marginTop="5dp"
        android:textSize="20dp"
        android:textColor="@color/white"
        />
    <EditText
        android:id="@+id/nome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/create_account"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="50dp"
        android:layout_marginHorizontal="25dp"
        android:background="@drawable/bg_editext"
        android:padding="14dp"
        android:hint="@string/nome_box"
        android:inputType="text"
        android:textColorHint="@color/search_header"
        />
    <EditText
        android:id="@+id/nick"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/nome"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="50dp"
        android:layout_marginHorizontal="25dp"
        android:background="@drawable/bg_editext"
        android:padding="14dp"
        android:hint="@string/nick_box"
        android:inputType="text"
        android:textColorHint="@color/search_header"
        />
    <EditText
        android:id="@+id/email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/nick"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="25dp"
        android:layout_marginHorizontal="25dp"
        android:background="@drawable/bg_editext"
        android:padding="14dp"
        android:hint="@string/email"
        android:inputType="text"
        android:textColorHint="@color/search_header"
        />
    <EditText
        android:id="@+id/senha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/email"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="25dp"
        android:layout_marginHorizontal="25dp"
        android:background="@drawable/bg_editext"
        android:padding="14dp"
        android:hint="@string/senha"
        android:inputType="text"
        android:textColorHint="@color/search_header"
        />
    <EditText
        android:id="@+id/senha2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/senha"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="25dp"
        android:layout_marginHorizontal="25dp"
        android:background="@drawable/bg_editext"
        android:padding="14dp"
        android:hint="@string/confirma_senha"
        android:inputType="text"
        android:textColorHint="@color/search_header"
        />


    <Button
        android:id="@+id/subscribeButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cadastro"
        app:layout_constraintTop_toBottomOf="@id/senha2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:backgroundTint="@color/white"
        android:layout_marginTop="25dp"
        android:textColor="@color/search_header"
        />

</androidx.constraintlayout.widget.ConstraintLayout>