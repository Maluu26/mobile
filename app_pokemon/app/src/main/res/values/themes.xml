<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.App_Pokemon" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Cores próprias do app (sem isso o Material 3 usa o roxo padrão) -->
        <item name="colorPrimary">@color/search_header</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/light_green</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:colorBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorControlActivated">@color/search_header</item>
    </style>
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowNoTitle">true</item>
        <item name="windowSplashScreenBackground">@color/splash</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Base.Theme.App_Pokemon</item>
    </style>
    <style name="Theme.App_Pokemon" parent="Base.Theme.App_Pokemon" />
</resources>