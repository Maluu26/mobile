<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    tools:context=".SeeProductsActivity">
    <ImageView

        android:src="@drawable/outline_arrow_back_24"
        android:id="@+id/voltar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <TextView
        android:id="@+id/pagename"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/voltar"
        app:layout_constraintTop_toTopOf="parent"
        android:text="Visualizar Produto"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="1dp"
        android:textSize="20dp"
        />
    <EditText
        android:layout_marginTop="40dp"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/voltar"
        android:id="@+id/product_name"
        android:text="@string/p_nome"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:hint="@string/nome"
        />
    <Button
        android:id="@+id/procura"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/pagename"
       app:layout_constraintLeft_toRightOf="@id/product_name"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="50dp"
        android:hint="search"
        android:textColorHint="@color/white"/>
   <TextView
       android:layout_marginTop="20dp"
       android:id="@+id/nomeT"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       app:layout_constraintLeft_toLeftOf="parent"
       app:layout_constraintTop_toBottomOf="@id/product_name"
       android:text="@string/nome"
       android:textSize="20dp"
       />
    <TextView
        android:id="@+id/nomeBusca"
        android:layout_marginTop="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toRightOf="@id/nomeT"
        app:layout_constraintTop_toBottomOf="@id/product_name"
        android:text="@string/p_nome"
        app:layout_constraintRight_toRightOf="parent"
        />
    <TextView
        android:layout_marginTop="20dp"
        android:id="@+id/valorT"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nomeT"
        android:text="@string/valor"
        android:textSize="20dp"
        />
    <TextView
        android:id="@+id/valorBusca"
        android:layout_marginTop="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toRightOf="@id/valorT"
        app:layout_constraintTop_toBottomOf="@id/nomeBusca"
        android:text="@string/p_valor"
        app:layout_constraintRight_toRightOf="parent"
        />

    <TextView
        android:layout_marginTop="20dp"
        android:id="@+id/quantT"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/valorT"
        android:text="@string/disp"
        android:textSize="20dp"
        />
    <TextView
        android:id="@+id/quantBusca"
        android:layout_marginTop="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toRightOf="@id/quantT"
        app:layout_constraintTop_toBottomOf="@id/valorBusca"
        android:text="@string/p_disp"
        app:layout_constraintRight_toRightOf="parent"
        />


</androidx.constraintlayout.widget.ConstraintLayout>