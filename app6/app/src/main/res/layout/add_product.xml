<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AddProductActivity"
   android:padding="20dp"
    android:layout_marginTop="20dp"
   >
    <ImageView

        android:src="@drawable/outline_arrow_back_24"
        android:id="@+id/voltar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />
    <TextView

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/voltar"
        app:layout_constraintTop_toTopOf="parent"
        android:text="Adicionar Produto"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="1dp"
        android:textSize="20dp"
        />
    <EditText
        android:layout_marginTop="40dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/voltar"
        android:id="@+id/product_name"
        android:text="@string/p_nome"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:hint="@string/nome"
        />
    <EditText
        android:layout_marginTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/product_name"
        android:id="@+id/product_value"
        android:text="@string/p_valor"
        app:layout_constraintRight_toRightOf="parent"
        android:hint="@string/valor"
        />
    <EditText
        android:layout_marginTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/product_value"
        android:id="@+id/product_quanti"
        android:text="@string/p_disp"
        app:layout_constraintRight_toRightOf="parent"
        android:hint="@string/disp"
        />
    <Button
        android:id="@+id/insereProduto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/product_quanti"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="20dp"
        android:hint="@string/cadastra"
        android:textColorHint="@color/white"/>

</androidx.constraintlayout.widget.ConstraintLayout>