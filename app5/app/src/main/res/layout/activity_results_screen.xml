<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.ResultsScreen">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/azul_marinho"
        app:layout_constraintHeight_percent="0.10"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        >
        <ImageView
            android:id="@+id/arrowBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/outline_arrow_back_24"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/header"
            android:layout_margin="15dp"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toRightOf="@id/arrowBack"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/header"
            android:layout_margin="15dp"
            android:text="@string/app"
            android:textColor="@color/white"
            android:layout_marginLeft="10dp"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bandeira"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/branco2"
        android:elevation="8dp"
        app:cardBackgroundColor="#AAAAAA"
        android:layout_marginTop="18dp"
        app:layout_constraintWidth_percent="0.80"
        app:layout_constraintHeight_percent="0.23"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintRight_toRightOf="parent"
        >
        <ImageView
            android:layout_marginLeft="20dp"
            android:id="@+id/imgBandeira"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:scaleType="fitCenter"
            android:contentDescription="Bandeira do Estado"
            app:srcCompat="@drawable/bandeira_acre"
            app:layout_constraintTop_toTopOf="@id/bandeira"
            app:layout_constraintBottom_toBottomOf="@id/bandeira"
            app:layout_constraintStart_toStartOf="parent" />
        <TextView
            android:id="@+id/estadoTitle"
            android:layout_margin="30dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/uf"
            app:layout_constraintTop_toTopOf="@id/bandeira"
            app:layout_constraintLeft_toRightOf="@id/imgBandeira"
            app:layout_constraintRight_toRightOf="@id/bandeira"
            android:textColor="@color/azul_marinho"
            />
        <TextView
            android:id="@+id/estadoReal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/estadoTitle"
            android:text="@string/estadoValue"
            android:textColor="@color/azul_marinho"
            app:layout_constraintLeft_toRightOf="@id/imgBandeira"
            app:layout_constraintRight_toRightOf="@id/bandeira"
            android:layout_margin="20dp"/>


        <TextView
            android:id="@+id/sigla"
            android:layout_margin="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ufValue"
           app:layout_constraintTop_toBottomOf="@id/estadoReal"
            app:layout_constraintLeft_toRightOf="@id/imgBandeira"
            app:layout_constraintRight_toRightOf="@id/bandeira"
            android:textColor="@color/azul_marinho"

            />

    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/endereco"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_percent="0.80"
        app:layout_constraintHeight_percent="0.30"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bandeira"
        android:layout_marginTop="20dp"
        android:background="@android:color/white"
        android:elevation="8dp"
        app:cardBackgroundColor="#AAAAAA"
        >
        <ImageView
            android:id="@+id/pin"
            app:layout_constraintTop_toTopOf="@id/endereco"
            app:layout_constraintLeft_toLeftOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingLeft="10dp"
            android:src="@drawable/pin"
            />
        <TextView
            android:id="@+id/enderecoBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/endereco"
            app:layout_constraintTop_toTopOf="@id/endereco"
            android:layout_marginTop="12dp"
            android:paddingLeft="10dp"
            app:layout_constraintLeft_toRightOf="@id/pin"
            android:textSize="15dp"
            android:textColor="@color/azul_marinho"
            />
        <TextView
            android:id="@+id/cepIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cep"
            app:layout_constraintTop_toBottomOf="@id/enderecoBox"
            android:layout_marginTop="12dp"
            android:paddingLeft="10dp"
            app:layout_constraintLeft_toRightOf="@id/pin"
            android:textSize="13dp"
            android:textColor="@color/azul_marinho"
            />
        <TextView
            android:id="@+id/cepValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cepValue"
            app:layout_constraintTop_toBottomOf="@id/enderecoBox"
            android:layout_marginTop="12dp"
            android:paddingLeft="88dp"
            app:layout_constraintLeft_toRightOf="@id/cepIcon"
            android:textSize="13dp"
            android:textColor="@color/azul_marinho"
            />
        <TextView
            android:id="@+id/lograIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/logradouro"
            app:layout_constraintTop_toBottomOf="@id/cepIcon"
            android:layout_marginTop="12dp"
            android:paddingLeft="10dp"
            app:layout_constraintLeft_toRightOf="@id/pin"
            android:textSize="13dp"
            android:textColor="@color/azul_marinho"
            />
        <TextView
            android:id="@+id/lograValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cepValue"
            app:layout_constraintTop_toBottomOf="@id/cepValue"
            android:layout_marginTop="12dp"
            android:paddingLeft="48dp"
            app:layout_constraintLeft_toRightOf="@id/lograIcon"
            android:textSize="13dp"
            android:textColor="@color/azul_marinho"
            />
        <TextView
            android:id="@+id/complementoIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/complem"
            app:layout_constraintTop_toBottomOf="@id/lograIcon"
            android:layout_marginTop="12dp"
            android:paddingLeft="10dp"
            app:layout_constraintLeft_toRightOf="@id/pin"
            android:textSize="13dp"
            android:textColor="@color/azul_marinho"
            />
        <TextView
            android:id="@+id/complementoValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/complemValue"
            app:layout_constraintTop_toBottomOf="@id/lograValue"
            android:layout_marginTop="12dp"
            android:paddingLeft="51dp"
            android:textAlignment="center"
            app:layout_constraintLeft_toRightOf="@id/lograIcon"
            android:textSize="13dp"
            android:textColor="@color/azul_marinho"
            />
        <TextView
            android:id="@+id/bairroIcon"
            android:justificationMode="inter_word"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bairro"
            app:layout_constraintTop_toBottomOf="@id/complementoIcon"
            android:layout_marginTop="12dp"
            android:paddingLeft="10dp"
            app:layout_constraintLeft_toRightOf="@id/pin"
            android:textSize="13dp"
            android:textColor="@color/azul_marinho"
            />
        <TextView
            android:id="@+id/bairroValue"
            android:textAlignment="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bairroValue"
            app:layout_constraintTop_toBottomOf="@id/complementoIcon"
            android:layout_marginTop="12dp"
            android:paddingLeft="80dp"
            app:layout_constraintLeft_toRightOf="@id/bairroIcon"
            android:textSize="13dp"
            android:textColor="@color/azul_marinho"
            />
        <TextView
            android:id="@+id/cidadeIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cidade"
            app:layout_constraintTop_toBottomOf="@id/bairroIcon"
            android:layout_marginTop="12dp"
            android:paddingLeft="10dp"
            app:layout_constraintLeft_toRightOf="@id/pin"
            android:textSize="13dp"
            android:textColor="@color/azul_marinho"
            />
        <TextView
            android:id="@+id/cidadeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cidadeValue"
            app:layout_constraintTop_toBottomOf="@id/bairroValue"
            android:layout_marginTop="12dp"
            android:paddingLeft="80dp"
            app:layout_constraintLeft_toRightOf="@id/bairroIcon"
            android:textSize="13dp"
            android:textColor="@color/azul_marinho"
            />
        <TextView
            android:id="@+id/estadoIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/uf"
            app:layout_constraintTop_toBottomOf="@id/cidadeIcon"
            android:layout_marginTop="12dp"
            android:paddingLeft="10dp"
            app:layout_constraintLeft_toRightOf="@id/pin"
            android:textSize="13dp"
            android:textColor="@color/azul_marinho"
            />
        <TextView
            android:id="@+id/estadoValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/estadoValue"
            app:layout_constraintTop_toBottomOf="@id/cidadeValue"
            android:layout_marginTop="12dp"
            android:paddingLeft="80dp"
            app:layout_constraintLeft_toRightOf="@id/bairroIcon"
            android:textSize="13dp"
            android:textColor="@color/azul_marinho"
            />

</androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/adicionais"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_percent="0.80"
        app:layout_constraintHeight_percent="0.24"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/endereco"
        android:layout_marginTop="20dp"
        android:background="@android:color/white"
        android:elevation="8dp"
        app:cardBackgroundColor="#AAAAAA"
        >
        <ImageView
            android:id="@+id/pin2"
            app:layout_constraintTop_toTopOf="@id/adicionais"
            app:layout_constraintLeft_toLeftOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingLeft="10dp"
            android:src="@drawable/pin"
            />
        <TextView
            android:id="@+id/infosBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/infos"
            app:layout_constraintTop_toTopOf="@id/adicionais"
            android:layout_marginTop="10dp"
            android:paddingLeft="10dp"
            app:layout_constraintLeft_toRightOf="@id/pin2"
            android:textSize="15dp"
            android:textColor="@color/azul_marinho"
            />
        <TextView
            android:id="@+id/regIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/regiao"
            app:layout_constraintTop_toBottomOf="@id/infosBox"
            android:layout_marginTop="12dp"
            android:paddingLeft="10dp"
            app:layout_constraintLeft_toRightOf="@id/pin2"
            android:textSize="13dp"
            android:textColor="@color/azul_marinho"
            />
        <TextView
            android:id="@+id/regValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/regiaoValue"
            app:layout_constraintTop_toBottomOf="@id/infosBox"
            android:layout_marginTop="12dp"
            android:paddingLeft="37dp"
            app:layout_constraintLeft_toRightOf="@id/regIcon"
            app:layout_constraintRight_toLeftOf="@id/mapa"
            android:textSize="13dp"
            android:textColor="@color/azul_marinho"
            />
        <TextView
            android:id="@+id/capitalIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/capital"
            app:layout_constraintTop_toBottomOf="@id/regIcon"
            android:layout_marginTop="12dp"
            android:paddingLeft="10dp"
            app:layout_constraintLeft_toRightOf="@id/pin2"
            android:textSize="13dp"
            android:textColor="@color/azul_marinho"
            />
        <TextView
            android:id="@+id/capitalValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/capitalValue"
            app:layout_constraintTop_toBottomOf="@id/regIcon"
            android:layout_marginTop="12dp"
            android:paddingLeft="45dp"
            app:layout_constraintLeft_toRightOf="@id/capitalIcon"
            android:textSize="13dp"
            android:textColor="@color/azul_marinho"
            />
        <TextView
            android:id="@+id/dddIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ddd"
            app:layout_constraintTop_toBottomOf="@id/capitalIcon"
            android:layout_marginTop="12dp"
            android:paddingLeft="10dp"
            app:layout_constraintLeft_toRightOf="@id/pin2"
            android:textSize="13dp"
            android:textColor="@color/azul_marinho"
            />
        <TextView
            android:id="@+id/dddValue"
            android:textAlignment="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dddValue"
            app:layout_constraintTop_toBottomOf="@id/capitalIcon"
            android:layout_marginTop="12dp"
            android:paddingLeft="62dp"
            app:layout_constraintLeft_toRightOf="@id/dddIcon"
            android:textSize="13dp"
            android:textColor="@color/azul_marinho"
            />
        <TextView
            android:id="@+id/codigo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/codigoIBGE"
            app:layout_constraintTop_toBottomOf="@id/dddIcon"
            android:layout_marginTop="12dp"
            android:paddingLeft="10dp"
            app:layout_constraintLeft_toRightOf="@id/pin2"
            android:textSize="13dp"
            android:textColor="@color/azul_marinho"
            />
        <TextView
            android:id="@+id/codigoValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/codigoIBGEValue"
            app:layout_constraintTop_toBottomOf="@id/dddValue"
            android:layout_marginTop="12dp"
            android:paddingLeft="22dp"
            android:textAlignment="center"
            app:layout_constraintLeft_toRightOf="@id/codigo"
            android:textSize="13dp"
            android:textColor="@color/azul_marinho"
            />
        <ImageView
            android:id="@+id/mapa"
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:layout_constraintTop_toBottomOf="@id/infosBox"
            app:layout_constraintRight_toRightOf="parent"
            android:src="@drawable/mapa_ba"
            app:layout_constraintLeft_toRightOf="@id/regValue"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>