<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.CEP"
    android:padding="10dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/azul_marinho"
        app:layout_constraintHeight_percent="0.15"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        >
        <ImageView
            android:id="@+id/app_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="@id/header"
            app:layout_constraintBottom_toBottomOf="@id/header"
            android:src="@drawable/baseline_navigation_24"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@id/app_name"
            app:layout_constraintHorizontal_chainStyle="packed"

            />
        <TextView
            android:id="@+id/app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toRightOf="@id/app_icon"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@id/header"
           app:layout_constraintBottom_toBottomOf="@id/header"
            android:text="@string/app"
            android:textColor="@color/white"
            app:layout_constraintHorizontal_chainStyle="packed"
            android:textSize="20dp"
            />
</androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:id="@+id/digite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/digite"
        android:textAlignment="center"
       android:layout_marginVertical="100dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:textSize="18dp"
        android:layout_marginTop="15dp"
        android:textColor="@color/azul_marinho"
        android:fontFamily="monospace"
        />
    <TextView
        android:id="@+id/instrucao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/instrucoes"
        android:textAlignment="center"
        app:layout_constraintTop_toBottomOf="@id/digite"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:textSize="16dp"
        android:paddingHorizontal="15dp"
        android:textColor="@color/azul_marinho"
        android:fontFamily="monospace"
        />

    <EditText
        android:id="@+id/digCep"
        android:inputType="number"
        android:drawableStart="@drawable/outline_add_location_24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/instrucao"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:padding="15dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="50dp"
        android:hint="@string/digite"
        android:textColorHint="@color/black"
        app:layout_constraintBottom_toTopOf="@id/botCep"
        />

    <Button
        android:layout_marginHorizontal="10dp"
        android:id="@+id/botCep"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/digCep"
        android:padding="15dp"
        android:hint="@string/botaoCEP"
        android:textColorHint="@color/white"
        android:backgroundTint="@color/azul_marinho"

        />

</androidx.constraintlayout.widget.ConstraintLayout>