<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="40dp"
    tools:context=".MainActivity">

   <EditText
       android:id="@+id/prim_nome"
       android:layout_width="0dp"
       android:layout_height="wrap_content"
       app:layout_constraintHorizontal_chainStyle="spread"
       app:layout_constraintLeft_toLeftOf="parent"
       app:layout_constraintRight_toLeftOf="@id/sec_nome"
       app:layout_constraintTop_toTopOf="parent"
       android:hint="@string/name"
       />
    <EditText
        android:id="@+id/sec_nome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toRightOf="@id/prim_nome"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:hint="@string/middle_name"/>
    <EditText
        android:id="@+id/sobrenome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sec_nome"
        android:hint="@string/last_name"/>
    <Button
        android:id="@+id/enviar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/sobrenome"
        android:hint="Concat"
        android:textColorHint="@color/white"/>

    <TextView
        android:id="@+id/result_descric"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/enviar"
        app:layout_constraintLeft_toLeftOf="parent"
        android:text="@string/full_name_caption"
        android:textSize="20sp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="3dp"
        app:layout_constraintHorizontal_chainStyle="packed"
        />
    <TextView
        android:id="@+id/resultado"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/enviar"
        app:layout_constraintLeft_toRightOf="@id/result_descric"
        app:layout_constraintRight_toRightOf="parent"
        android:text="@string/full_name"
        android:textSize="20sp"
        android:layout_marginTop="20dp"
        />

</androidx.constraintlayout.widget.ConstraintLayout>